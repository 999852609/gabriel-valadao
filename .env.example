# SerpApi — cadastre-se grátis em https://serpapi.com (pode usar conta Google)
SERPAPI_KEY=your_api_key_here

# E-mail (Gmail com App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_app_password
ALERT_EMAIL_TO=seu_email@gmail.com

# Configurações de alerta
ORIGIN_AIRPORT=GYN
MAX_PRICE_BRL=800
PRICE_DROP_PERCENT=20
